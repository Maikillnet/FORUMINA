# Скопируйте этот файл в .env и задайте свои значения.
# .env уже в .gitignore — секреты сюда, .env.example — только пример.

PORT=3001

# Обязательно задайте длинную случайную строку в production.
# Можно сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Через сколько токен авторизации перестаёт быть валидным.
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
